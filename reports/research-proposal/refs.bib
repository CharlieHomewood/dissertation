  author = {Anzer, Gabriel and Bauer, Pascal},
  date = {2021-03-29},
  journaltitle = {Frontiers in Sports and Active Living},
  shortjournal = {Front Sports Act Living},
  volume = {3},
  eprint = {33889843},
  eprinttype = {pubmed},
