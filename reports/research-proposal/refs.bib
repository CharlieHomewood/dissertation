@inproceedings{decroosActionsSpeakLouder2019,
  title = {Actions {{Speak Louder}} than {{Goals}}: {{Valuing Player Actions}} in {{Soccer}}},
  shorttitle = {Actions {{Speak Louder}} than {{Goals}}},
  booktitle = {Proceedings of the 25th {{ACM SIGKDD International Conference}} on {{Knowledge Discovery}} \& {{Data Mining}}},
  author = {Decroos, Tom and Bransen, Lotte and Van Haaren, Jan and Davis, Jesse},
  date = {2019-07-25},
  series = {{{KDD}} '19},
  pages = {1851--1861},
  publisher = {Association for Computing Machinery},
  location = {New York, NY, USA},
  doi = {10.1145/3292500.3330758},
  url = {https://dl.acm.org/doi/10.1145/3292500.3330758},
  urldate = {2026-04-13},
  abstract = {Assessing the impact of the individual actions performed by soccer players during games is a crucial aspect of the player recruitment process. Unfortunately, most traditional metrics fall short in addressing this task as they either focus on rare actions like shots and goals alone or fail to account for the context in which the actions occurred. This paper introduces (1) a new language for describing individual player actions on the pitch and (2) a framework for valuing any type of player action based on its impact on the game outcome while accounting for the context in which the action happened. By aggregating soccer players' action values, their total offensive and defensive contributions to their team can be quantified. We show how our approach considers relevant contextual information that traditional player evaluation metrics ignore and present a number of use cases related to scouting and playing style characterization in the 2016/2017 and 2017/2018 seasons in Europe's top competitions.},
  isbn = {978-1-4503-6201-6},
  file = {C:\Users\Charlie\Zotero\storage\CSBLPGJX\Decroos et al. - 2019 - Actions Speak Louder than Goals Valuing Player Actions in Soccer.pdf}
}

@incollection{desa-freireEventDataBased2025,
  title = {Event {{Data Based Action Valuation}}: {{Possibilities}} and {{Limitations}}},
  shorttitle = {Event {{Data Based Action Valuation}}},
  booktitle = {Artificial {{Intelligence}} and {{Machine Learning}} in {{Sports Science}}},
  author = {family=Sá-Freire, given=Leo Martins, prefix=de, useprefix=true},
  editor = {Memmert, Daniel},
  date = {2025},
  pages = {285--292},
  publisher = {Springer},
  location = {Berlin, Heidelberg},
  doi = {10.1007/978-3-662-70155-3_20},
  url = {https://doi.org/10.1007/978-3-662-70155-3_20},
  urldate = {2026-04-14},
  abstract = {This chapter explores the evolving field of action valuation metrics in soccer analytics, which significantly enhance the depth of quantitative analysis beyond traditional aggregate statistics. By providing a detailed assessment of each action’s value, these metrics address the specificity and granularity often missing in traditional statistical approaches. We will examine the VAEP metric as a case study, highlighting its utility and the insights it can offer into player and team performance over a season. We also discuss the limitations of these metrics, particularly the lack of spatial context in event data. Despite these challenges, action valuation metrics remain a potent tool, with ongoing developments aimed at refining their accuracy and applicability in professional sports. This chapter underscores the importance of using these metrics judiciously and explores potential enhancements to overcome their inherent limitations.},
  isbn = {978-3-662-70155-3},
  langid = {english}
}

