  author = {Goes, F.r. and Meerhoff, L.a. and Bueno, M.j.o. and Rodrigues, D.m. and Moura, F.a. and Brink, M.s. and Elferink-Gemser, M.t. and Knobbe, A.j. and Cunha, S.a. and Torres, R.s. and Lemmink, K.a.p.m.},
  date = {2021},
  journaltitle = {European Journal of Sport Science},
  volume = {21},
