@article{goesUnlockingPotentialBig2021,
  title = {Unlocking the Potential of Big Data to Support Tactical Performance Analysis in Professional Soccer: {{A}} Systematic Review},
  shorttitle = {Unlocking the Potential of Big Data to Support Tactical Performance Analysis in Professional Soccer},
  author = {Goes, F.r. and Meerhoff, L.a. and Bueno, M.j.o. and Rodrigues, D.m. and Moura, F.a. and Brink, M.s. and Elferink-Gemser, M.t. and Knobbe, A.j. and Cunha, S.a. and Torres, R.s. and Lemmink, K.a.p.m.},
  date = {2021},
  journaltitle = {European Journal of Sport Science},
  volume = {21},
  number = {4},
  pages = {481--496},
  issn = {1536-7290},
  doi = {10.1080/17461391.2020.1747552},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1080/17461391.2020.1747552},
  urldate = {2026-03-31},
  abstract = {In professional soccer, increasing amounts of data are collected that harness great potential when it comes to analysing tactical behaviour. Unlocking this potential is difficult as big data challenges the data management and analytics methods commonly employed in sports. By joining forces with computer science, solutions to these challenges could be achieved, helping sports science to find new insights, as is happening in other scientific domains. We aim to bring multiple domains together in the context of analysing tactical behaviour in soccer using position tracking data. A systematic literature search for studies employing position tracking data to study tactical behaviour in soccer was conducted in seven electronic databases, resulting in 2338 identified studies and finally the inclusion of 73 papers. Each domain clearly contributes to the analysis of tactical behaviour, albeit in – sometimes radically – different ways. Accordingly, we present a multidisciplinary framework where each domain's contributions to feature construction, modelling and interpretation can be situated. We discuss a set of key challenges concerning the data analytics process, specifically feature construction, spatial and temporal aggregation. Moreover, we discuss how these challenges could be resolved through multidisciplinary collaboration, which is pivotal in unlocking the potential of position tracking data in sports analytics.},
  langid = {english},
  keywords = {big data,Football,performance analysis,tactical analysis,team sport},
  file = {C\:\\Users\\Charlie\\Zotero\\storage\\37I35K7F\\Goes et al. - 2021 - Unlocking the potential of big data to support tactical performance analysis in professional soccer.pdf;C\:\\Users\\Charlie\\Zotero\\storage\\9AJW93PN\\17461391.2020.html}
}

@article{olthofPerspectivesDataAnalytics2025,
  title = {Perspectives on Data Analytics for Gaining a Competitive Advantage in Football: Computational Approaches to Tactics},
  shorttitle = {Perspectives on Data Analytics for Gaining a Competitive Advantage in Football},
  author = {Olthof, Sigrid and Davis, Jesse},
  date = {2025-07-21},
  journaltitle = {Science and Medicine in Football},
  volume = {0},
  number = {0},
  eprint = {40689477},
  eprinttype = {pubmed},
  pages = {1--13},
  publisher = {Routledge},
  issn = {2473-3938},
  doi = {10.1080/24733938.2025.2533784},
  url = {https://doi.org/10.1080/24733938.2025.2533784},
  urldate = {2026-03-31},
  abstract = {The role of data-driven analyses is becoming more prominent in football. These have the potential to impact decision-making processes for team performance and player recruitment. Research in this area makes use of large datasets consisting of event and tracking data from multiple teams, leagues and seasons. A well-known computational solution is the Expected Goal model for post-match analysis and operational decision-making. Despite a shared research interest in football tactics, computational research in football is somewhat disconnected from the sports science community. We believe that there is much to gain from a closer collaboration between these disparate communities. To this end, the present commentary has three goals. First, we want to synthesize the historical computational work in areas such as evaluating tactics, predicting player and team success, and modeling players’ movements. This work has largely been published in technical computational venues, and hence we hope to provide an access point for those interested in learning about this area. Second, we will highlight some emerging topics, such as automating parts of match analysis and analyzing decision-making. These are topics that require an in-depth collaboration with domain experts and therefore would benefit from a tighter integration among these communities. Third, we would like to discuss some advice and initiatives that we hope will be helpful in strengthening the ties between these communities.},
  keywords = {artificial intelligence,football analytics,machine learning,Soccer,soccer analytics},
  file = {C:\Users\Charlie\Zotero\storage\2Z49JBER\Olthof and Davis - 2025 - Perspectives on data analytics for gaining a competitive advantage in football computational approa.pdf}
}

